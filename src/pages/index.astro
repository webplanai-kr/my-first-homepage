
---
import { site } from "../data/site";
import "../styles/global.css";
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.introduction} />
    <meta name="theme-color" content="#f8f7f3" />
    <title>{site.companyName} | Brand & Digital Studio</title>
  </head>

  <body>
    <header class="site-header">
      <a class="site-logo" href="#home">{site.companyName}</a>

      <nav class="site-nav" aria-label="주 메뉴">
        {site.menu.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <a class="header-cta" href="#contact">프로젝트 문의 ↗</a>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-copy">
          <p class="eyebrow">{site.tagline}</p>
          <h1 set:html={site.headline.replace(/\n/g, "<br />")} />
          <p class="hero-description">{site.introduction}</p>

          <div class="hero-actions">
            <a class="button button-dark" href="#projects">
              프로젝트 보기 <span>↗</span>
            </a>
            <a class="text-link" href="#about">우리가 하는 일 알아보기 ↓</a>
          </div>
        </div>

        <div class="hero-art" aria-label="브랜드 디자인을 표현한 추상 그래픽">
          <div class="art-circle"></div>
          <div class="art-square"></div>
          <div class="art-orbit"></div>
          <span class="art-label">IDEAS INTO<br />EXPERIENCE.</span>
          <span class="art-index">FIG. 001 — MORROW</span>
        </div>

        <div class="hero-bottom">
          <span>INDEPENDENT CREATIVE STUDIO</span>
          <a href="#about">SCROLL TO EXPLORE ↓</a>
        </div>
      </section>

      <section class="about section-wrap" id="about">
        <div class="section-label">
          <span class="section-number">01 /</span>
          <span>ABOUT MORROW</span>
        </div>

        <div class="about-content">
          <h2 set:html={site.aboutTitle.replace(/\n/g, "<br />")} />
          <div class="about-detail">
            <p>{site.aboutDescription}</p>
            <a class="text-link" href="#services">우리가 하는 일 ↗</a>
          </div>
        </div>
      </section>

      <section class="services section-wrap" id="services">
        <div class="section-heading">
          <div>
            <p class="eyebrow">WHAT WE DO</p>
            <h2>생각을 디자인하고<br />가치를 연결합니다.</h2>
          </div>
          <p class="heading-note">
            전략부터 실행까지,<br />
            브랜드에 필요한 경험을 만듭니다.
          </p>
        </div>

        <div class="services-grid">
          {site.services.map((service) => (
            <article class="service-card">
              <div class="service-top">
                <span>{service.number}</span>
                <span class="service-arrow">↗</span>
              </div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="projects section-wrap" id="projects">
        <div class="section-label">
          <span class="section-number">02 /</span>
          <span>SELECTED WORK</span>
        </div>

        <div class="projects-heading">
          <h2>작은 차이가<br />큰 인상을 만듭니다.</h2>
          <p>브랜드마다 다른 이야기를<br />고유한 디자인으로 표현합니다.</p>
        </div>

        <div class="project-grid">
          <article class="project-card project-one">
            <div class="project-visual visual-one">
              <span class="visual-type">OBJECTS FOR EVERYDAY</span>
              <div class="object-shape"></div>
              <span class="visual-word">FORM<br />FOLLOWS<br />FEELING.</span>
            </div>
            <div class="project-meta">
              <div>
                <h3>FORM OBJECTS</h3>
                <p>Brand Identity · Web Design</p>
              </div>
              <span>2026</span>
            </div>
          </article>

          <article class="project-card project-two">
            <div class="project-visual visual-two">
              <span class="visual-type">A QUIETER KIND OF LIVING</span>
              <div class="visual-window"></div>
              <span class="visual-word">SLOW<br />LIVING.</span>
            </div>
            <div class="project-meta">
              <div>
                <h3>STAY SLOW</h3>
                <p>Art Direction · Digital</p>
              </div>
              <span>2026</span>
            </div>
          </article>
        </div>
        <p class="project-disclaimer">
          위 프로젝트는 디자인 시안용 가상 사례입니다.
        </p>
      </section>

      <section class="contact" id="contact">
        <p class="eyebrow">HAVE A PROJECT IN MIND?</p>
        <h2 set:html={site.contactTitle.replace(/\n/g, "<br />")} />
        <p>{site.contactDescription}</p>

        <a class="button button-light" href={`mailto:${site.email}`}>
          이메일로 문의하기 ↗
        </a>

        <div class="contact-details">
          <a href={`tel:${site.phone}`}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="site-logo" href="#home">{site.companyName}</a>
      <p>{site.footer}</p>
      <a href="#home">BACK TO TOP ↑</a>
    </footer>
  </body>
</html>
