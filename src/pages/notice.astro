
---
import { site } from "../data/site";
import "../styles/global.css";

type Notice = {
  id: number;
  date: string;
  link: string;
  title: { rendered: string };
  excerpt: { rendered: string };
};

let notices: Notice[] = [];
let loadError = false;

try {
  const response = await fetch(
    "http://notice-board.local/wp-json/wp/v2/posts?categories=3&orderby=date&order=desc"
  );

  if (!response.ok) {
    throw new Error("공지사항을 불러오지 못했습니다.");
  }

  notices = await response.json();
} catch (error) {
  loadError = true;
}

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("ko-KR", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(new Date(date));
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="MORROW Studio 공지사항" />
    <title>공지사항 | {site.companyName}</title>
  </head>

  <body>
    <header class="site-header">
      <a class="site-logo" href="/#home">{site.companyName}</a>

      <nav class="site-nav" aria-label="주 메뉴">
        {
          site.menu.map((item) => (
            <a
              href={
                item.href.startsWith("#")
                  ? `/${item.href}`
                  : item.href
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a class="header-cta" href="/#contact">
        프로젝트 문의 ↗
      </a>
    </header>

    <main class="notice-page">
      <section class="notice-heading">
        <p class="notice-eyebrow">MORROW STUDIO</p>
        <h1>공지사항</h1>
        <p>모로우 스튜디오의 새로운 소식을 전해드립니다.</p>
      </section>

      <section class="notice-list" aria-label="공지사항 목록">
        {#if loadError}
          <p class="notice-message">
            공지사항을 불러오지 못했습니다. 잠시 후 다시 확인해 주세요.
          </p>
        {:else if notices.length === 0}
          <p class="notice-message">
            등록된 공지사항이 없습니다.
          </p>
        {:else}
          {#each notices as notice}
            <article class="notice-item">
              <div class="notice-meta">
                NOTICE
                <span>{formatDate(notice.date)}</span>
              </div>

              <h2>
                <a href={notice.link} target="_blank" rel="noopener noreferrer">
                  <span set:html={notice.title.rendered}></span>
                </a>
              </h2>

              <div
                class="notice-excerpt"
                set:html={notice.excerpt.rendered}
              ></div>

              <a
                class="notice-more"
                href={notice.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                자세히 보기 ↗
              </a>
            </article>
          {/each}
        {/if}
      </section>
    </main>

    <style>
      .notice-page {
        max-width: 1320px;
        margin: 0 auto;
        padding: 100px 6% 140px;
      }

      .notice-heading {
        padding-bottom: 55px;
        border-bottom: 1px solid var(--line);
      }

      .notice-eyebrow {
        color: var(--muted);
        font-size: 12px;
        letter-spacing: 0.12em;
      }

      .notice-heading h1 {
        margin: 22px 0;
        font-size: clamp(42px, 6vw, 76px);
        font-weight: 500;
        letter-spacing: -0.06em;
      }

      .notice-heading > p:last-child {
        color: var(--muted);
        font-size: 16px;
      }

      .notice-item {
        padding: 38px 0;
        border-bottom: 1px solid var(--line);
      }

      .notice-meta {
        color: var(--muted);
        font-size: 12px;
        letter-spacing: 0.08em;
      }

      .notice-meta span {
        margin-left: 16px;
        letter-spacing: 0;
      }

      .notice-item h2 {
        margin: 18px 0 12px;
        font-size: clamp(22px, 3vw, 30px);
        font-weight: 500;
        letter-spacing: -0.04em;
      }

      .notice-item h2 a {
        color: var(--text);
        text-decoration: none;
      }

      .notice-excerpt {
        color: var(--muted);
        font-size: 15px;
        line-height: 1.8;
      }

      .notice-more {
        display: inline-block;
        margin-top: 20px;
        color: var(--text);
        font-size: 13px;
        text-decoration: none;
      }

      .notice-message {
        padding: 60px 0;
        color: var(--muted);
        text-align: center;
      }

      @media (max-width: 700px) {
        .notice-page {
          padding: 70px 6% 100px;
        }

        .notice-heading {
          padding-bottom: 38px;
        }
      }
    </style>
  </body>
</html>
